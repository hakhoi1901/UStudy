# -----------------------------------------------------------------------------
# USTUY ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# AI Provider: 'gemini', 'groq', hoặc 'auto' (Chế độ auto: Thử Gemini trước, nếu bị giới hạn lượt gọi sẽ tự động nhảy sang Groq)
VITE_AI_PROVIDER=auto

# Google Gemini Configuration
# Lấy API Key miễn phí tại: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Groq Cloud Configuration
# Lấy API Key miễn phí tại: https://console.groq.com/
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-specdec

# Supabase Group Room Sync
# Server/local dev nen dung service_role key de endpoint /api/group-room ghi duoc du lieu khi RLS bat.
# Khong dat anon key vao SUPABASE_SERVICE_ROLE_KEY. Neu chi co anon key, dung SUPABASE_ANON_KEY va tao RLS policy trong docs/group_room_sync.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_GROUP_ROOMS_TABLE=group_rooms
